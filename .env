# Telegram bot token from @BotFather (required to run bot)
BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to administer the bot
ADMIN_IDS=
# Where persistent state and export files are stored
DATA_DIR=./data
OUTPUT_DIR=./output
# Safety/resource limits
MAX_PAGES=25
MAX_DEPTH=2
MAX_RUNTIME_SECONDS=180
MAX_PAGE_BYTES=2000000
REQUEST_TIMEOUT_MS=12000
CRAWL_DELAY_MS=1000
MAX_CONCURRENT_JOBS=2
RETENTION_DAYS=14
# Polling is the only currently implemented update mode
TELEGRAM_MODE=polling
